{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @workspace/db run migrate && pnpm --filter @workspace/scripts run seed-if-empty && export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=2048' tsc --build ../../lib/db/tsconfig.json && NODE_OPTIONS='--max-old-space-size=2048' tsc --build ../../lib/trust-tiers/tsconfig.json && NODE_OPTIONS='--max-old-space-size=2048' tsc --build ../../lib/api-zod/tsconfig.json && NODE_OPTIONS='--max-old-space-size=2048' tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@types/compression": "^1.8.1",
    "@workspace/api-spec": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/trust-tiers": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.56.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.6.0",
    "livekit-server-sdk": "^2.18.0",
    "nodemailer": "^9.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "stripe": "^17.3.0",
    "twilio": "^6.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "ts-jest": "^29.4.11"
  }
}
