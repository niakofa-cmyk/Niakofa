# ============================================================================
# Niakofa — Required Railway Service Variables
# ============================================================================
# Copy these into your Railway service → Variables tab.
# Variables marked [BUILD] are also needed at build time.
# Variables marked [RUNTIME] are only needed at runtime.
# Variables marked [SECRET] must NEVER be committed — set them only in Railway.
# ============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/niakofa   # [SECRET] Railway Postgres plugin injects this automatically

# ── Redis (BullMQ workers — required in production) ──────────────────────────
REDIS_URL=redis://default:password@host:6379                # [SECRET] Railway Redis plugin injects this automatically

# ── LiveKit Circles media plane ───────────────────────────────────────────────
# Required for live audio/video. Without these, POST /media-token returns 503.
# Use wss:// for production; ws://localhost is for local LiveKit development only.
LIVEKIT_URL=wss://your-project.livekit.cloud                  # [RUNTIME]
LIVEKIT_API_KEY=APIxxxxxxxx                                    # [SECRET][RUNTIME]
LIVEKIT_API_SECRET=secretxxxxxxxx                              # [SECRET][RUNTIME]

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production                                          # [BUILD+RUNTIME] set in nixpacks.toml
SERVE_FRONTEND=true                                          # set in nixpacks.toml — enables Express to serve the React app
APP_URL=https://your-service.railway.app                    # [RUNTIME] used for Stripe Connect redirect URLs
ALLOWED_ORIGIN=https://your-service.railway.app             # [RUNTIME] restricts CORS to this origin in production

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Set both in Railway → Variables. NEVER hardcode these in committed files.
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here  # [BUILD] baked into the Vite/React bundle at build time
MAPBOX_TOKEN=your_mapbox_public_token_here       # [RUNTIME] read by server-side geocoding + directions routes

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...                               # [SECRET][RUNTIME] your Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_...                             # [SECRET][RUNTIME] Stripe webhook signing secret
# IMPORTANT: VITE_STRIPE_PUBLISHABLE_KEY is required for the payment UI.
# StripePaymentModal.tsx reads import.meta.env.VITE_STRIPE_PUBLISHABLE_KEY.
# Without it, the Stripe Elements form silently fails to initialize.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...                     # [BUILD] baked into the Vite bundle — use the publishable key (pk_live_ or pk_test_)

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SECRET=your-strong-admin-password-here                # [SECRET][RUNTIME] protects /admin route via x-admin-token header

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-64-char-random-hex-string-here          # [SECRET][RUNTIME] signs HMAC auth tokens

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key                      # [BUILD+RUNTIME]
VAPID_PRIVATE_KEY=your-vapid-private-key                    # [SECRET][RUNTIME] server-side only
CACHE_BUST=1781829247
