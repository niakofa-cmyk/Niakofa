{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "cache": [
    { "id": "pnpm-store", "paths": ["/root/.local/share/pnpm/store"] }
  ],
  "exclude": [
    "main.py",
    "pyproject.toml",
    "uv.lock",
    ".agents/outputs",
    ".agents/scripts",
    "niakofa-repo",
    "attached_assets",
    "screenshots",
    "reference"
  ],
  "steps": {
    "build": {
      "commands": [
        "pnpm install --frozen-lockfile",
        "pnpm run typecheck:libs",
        "pnpm --filter @workspace/api-spec run codegen",
        "GIT_COMMIT=${RAILWAY_GIT_COMMIT_SHA:-$(git rev-parse HEAD 2>/dev/null || echo unknown)} pnpm --filter @workspace/api-server run build",
        "NODE_ENV=production BASE_PATH=/ pnpm --filter @workspace/pay-it-forward run build",
        "pnpm --filter nia-service run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "bash scripts/start.sh"
  }
}
