{
  "$schema": "https://schema.railpack.com",
  "cache": [
    { "id": "pnpm-store", "paths": ["/root/.local/share/pnpm/store"] },
    { "id": "api-dist",   "paths": ["artifacts/api-server/dist"] },
    { "id": "fe-dist",    "paths": ["artifacts/pay-it-forward/dist"] },
    { "id": "tsbuild",    "paths": ["artifacts/pay-it-forward/.tsbuildinfo", "lib/api-client-react/dist"] }
  ],
  "steps": {
    "build": {
      "commands": [
        "pnpm install --frozen-lockfile",
        "pnpm run typecheck:libs",
        "pnpm --filter @workspace/api-spec run codegen",
        "pnpm --filter @workspace/api-server run build",
        "NODE_ENV=production BASE_PATH=/ pnpm --filter @workspace/pay-it-forward run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "node --enable-source-maps artifacts/api-server/dist/index.mjs"
  }
}
