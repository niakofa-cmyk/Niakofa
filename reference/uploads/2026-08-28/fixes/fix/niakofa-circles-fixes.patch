+import { classifyMediaError, type MediaReadinessCode } from "./circleMediaReadiness";
+
+/**
+ * UI-actionable reason a media-token request failed for good (i.e. after any
+ * 429/5xx retries were exhausted or didn't apply). Each maps to a distinct
+ * on-screen action rather than one generic "connection failed" message.
+ */
+export type MediaTokenErrorCode =
+  | "reauthenticate" // 401 — session expired, send the user through auth again
+  | "not_authorized" // 403 — not (or no longer) allowed in this Circle
+  | "session_ended" // 404 — Circle isn't live anymore
+  | "state_conflict" // 409 — Circle state changed under us, re-fetch and retry
+  | "rate_limited" // 429 that survived retries — back off longer
+  | "server_error" // 5xx that survived retries — infrastructure issue
+  | "unknown";
+
+export class MediaTokenError extends Error {
+  constructor(
+    message: string,
+    readonly code: MediaTokenErrorCode,
+    readonly status: number,
+    readonly retryAfterSeconds?: number,
+  ) {
+    super(message);
+    this.name = "MediaTokenError";
+  }
+}
+
+function classifyMediaTokenStatus(status: number): MediaTokenErrorCode {
+  switch (status) {
+    case 401:
+      return "reauthenticate";
+    case 403:
+      return "not_authorized";
+    case 404:
+      return "session_ended";
+    case 409:
+      return "state_conflict";
+    case 429:
+      return "rate_limited";
+    default:
+      return status >= 500 ? "server_error" : "unknown";
+  }
+}
 
