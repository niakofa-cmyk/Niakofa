# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# ── Environment files — NEVER commit secrets ─────────────────────────────────
# All .env files at any depth are ignored.  Use Railway Variables for secrets.
.env
.env.*
!.env.*.example
!.env.example

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/test-results/
/playwright-report/
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
node_modules/
zipFile.zip

# User-uploaded chat assets — may contain sensitive data
attached_assets/

# Unverified third-party/reference art must never be reintroduced into the
# public Legacy runtime. Keep source archives under docs/legacy-reference/.
/artifacts/pay-it-forward/public/legacy-character-assets/tv/
/artifacts/pay-it-forward/public/legacy-rpg-assets/encounter/
/artifacts/pay-it-forward/public/legacy-rpg-assets/animations/
/artifacts/pay-it-forward/public/legacy-reference-docs/animation-reference/darkninja/

# Agent temp outputs and audit scripts — never commit
.agents/outputs/
.agents/scripts/

# Python workspace artifacts from Replit env setup — not part of the app
main.py
pyproject.toml
uv.lock
