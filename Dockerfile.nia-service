# syntax=docker/dockerfile:1
#
# Nia-service Dockerfile — kept at the REPO ROOT intentionally.
#
# WHY THIS FILE IS HERE (not in artifacts/nia-service/):
#   Railway's Metal builder calls fsutil.NewFS(dockerfilePath) expecting a
#   directory as the build-context root. When dockerfilePath contained a
#   subdirectory separator (e.g. "artifacts/nia-service/Dockerfile"), the
#   builder treated the full path including filename as a directory → build
#   failed. A flat filename at the repo root avoids that code path entirely.
#   See: artifacts/nia-service/railway.toml
#
# WHY npm (not pnpm):
#   nia-service has zero workspace package dependencies — all of its imports
#   are relative paths within its own src/. Running pnpm --frozen-lockfile
#   over the full monorepo would trigger the root preinstall (user-agent
#   enforcement) and postinstall (esbuild native binary download) scripts,
#   both of which are brittle in Railway's Alpine build environment.
#   Plain npm install on the service's own package.json avoids all of that.

FROM node:20-alpine AS builder

WORKDIR /app

# Install all deps (including devDeps for tsc)
COPY artifacts/nia-service/package.json ./
RUN npm install

# Compile TypeScript
COPY artifacts/nia-service/tsconfig.json ./
COPY artifacts/nia-service/src ./src
RUN npx tsc

# ── Runtime image ─────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/dist ./dist
COPY artifacts/nia-service/package.json ./

# Production deps only in final image
RUN npm install --omit=dev

# Migrations run at startup via runMigrations() in lib/db.ts
COPY artifacts/nia-service/migrations ./migrations
COPY artifacts/nia-service/migrate.sql ./migrate.sql

EXPOSE 3001

CMD ["node", "dist/index.js"]
