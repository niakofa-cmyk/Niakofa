 @custom-variant dark (&:is(.dark *));
 
+/*
+ * `pb-safe` / `pt-safe` were being used throughout the app (BottomNav,
+ * BottomSheet, etc.) but were never actually defined anywhere — Tailwind
+ * silently dropped them, so the bottom nav and bottom sheets got zero
+ * safe-area padding on notched/home-indicator devices. Defining them here
+ * makes every existing usage in the codebase start working, in addition to
+ * the fixed-modal overlap fix in profile.tsx.
+ */
+@utility pb-safe {
+  padding-bottom: env(safe-area-inset-bottom, 0px);
+}
+@utility pt-safe {
+  padding-top: env(safe-area-inset-top, 0px);
+}
