{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "preinstall": "echo ok",
    "postinstall": "node node_modules/esbuild/install.js 2>/dev/null || true && (test -e artifacts/api-server/node_modules/esbuild || ln -sf \"$PWD/node_modules/esbuild\" artifacts/api-server/node_modules/esbuild) 2>/dev/null || true",
    "build": "pnpm run typecheck && pnpm -r --workspace-concurrency=1 --filter \"@workspace/pay-it-forward\" --if-present run build && pnpm -r --workspace-concurrency=1 --filter \"!@workspace/mockup-sandbox\" --filter \"!@workspace/circles-visual-reference\" --filter \"!@workspace/pay-it-forward\" --if-present run build",
    "lint": "npx eslint .",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --workspace-concurrency=1 --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "boundary-check": "node scripts/src/check-app-ai-boundary.js",
    "release-validate": "node scripts/src/release-validate.js",
    "audit:routes": "node scripts/src/audit-routes.mjs",
    "verify:livekit": "bash scripts/verify-livekit-env.sh",
    "release-smoke": "node scripts/src/release-smoke.mjs",
    "verify:platform": "node scripts/src/audit-routes.mjs && node scripts/src/check-app-ai-boundary.js",
    "test:browser": "playwright test",
    "test:diaspora-data-loop": "node --test scripts/diaspora-data-loop-contract.test.mjs",
    "test:diaspora-experience": "node --test scripts/diaspora-experience-contract.test.mjs",
    "test:dna-matching": "node --import tsx/esm --test scripts/dna-matching-contract.test.mjs",
    "test:production-gate": "node --test scripts/production-gate.test.mjs",
    "test:diaspora-triple-enhancement": "node --import tsx --test scripts/diaspora-triple-enhancement-contract.test.mjs",
    "test:diaspora-finalization": "node --import tsx --test scripts/diaspora-finalization-contract.test.mjs",
    "test:diaspora-experience-completion": "node --test scripts/diaspora-experience-completion-contract.test.mjs",
    "test:diaspora-final-wiring-live": "playwright test e2e/diaspora-final-wiring-live.spec.ts",
    "test:diaspora": "bash scripts/run-repo-diaspora-contracts.sh",
    "production-gate": "node scripts/production-gate.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.3",
    "@playwright/test": "^1.55.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "pnpm": "^11.22.0",
    "tsx": "^4.23.12"
  }
}