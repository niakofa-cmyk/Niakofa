modules = ["python-3.12", "web", "nodejs-22", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "scripts/start.sh"]
build = ["pnpm", "run", "build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/pay-it-forward: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"


[[workflows.workflow]]
name = "artifacts/pay-it-forward: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/pay-it-forward && CI=true PORT=5000 ./node_modules/.bin/vite --config vite.config.ts --host 0.0.0.0"
waitForPort = 5000

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/api-server && node ../../lib/db/scripts/run-migrations.mjs && ../../node_modules/.bin/tsx ../../scripts/src/seed-if-empty.ts && NODE_ENV=development PORT=8080 node build.mjs && NODE_ENV=development PORT=8080 node --enable-source-maps dist/index.mjs"
waitForPort = 8080


[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

